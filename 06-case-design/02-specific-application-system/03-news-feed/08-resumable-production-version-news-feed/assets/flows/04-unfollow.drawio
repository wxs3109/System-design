<mxfile host="app.diagrams.net" modified="2026-08-13T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false">
  <diagram id="unfollow-flow" name="Unfollow Take off the link">
    <mxGraphModel dx="1600" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Take off the link: first change the fact visibility, then clean up the copy asynchronously" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=22;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="800" height="35" as="geometry"/></mxCell>
        <mxCell id="sync-zone" value="Synchronization: Close the current focus period F1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#6C8EBF;dashed=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="75" width="660" height="350" as="geometry"/></mxCell>
        <mxCell id="async-zone" value="Asynchronous: delete index, invalidate cache, physically clean up old FeedItem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF8FF;strokeColor=#9673A6;dashed=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="75" width="850" height="500" as="geometry"/></mxCell>
        <mxCell id="bob" value="Bob&lt;br&gt;Follower" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="175" width="95" height="95" as="geometry"/></mxCell>
        <mxCell id="gateway" value="API Gateway&lt;br&gt;Authentication / Current Limitation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="205" y="185" width="130" height="75" as="geometry"/></mxCell>
        <mxCell id="follow-service" value="Follow Service&lt;br&gt;Find Bob → Alice&lt;br&gt;Currently valid follow_id = F1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="170" width="170" height="105" as="geometry"/></mxCell>
        <mxCell id="follow-store" value="Follow Store&lt;br&gt;&lt;b&gt;Same transaction&lt;/b&gt;&lt;br&gt;F1.unfollowed_at = now&lt;br&gt;+ FollowEnded Outbox&lt;br&gt;Do not delete history records" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#3A7D44;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="150" width="80" height="145" as="geometry"/></mxCell>
        <mxCell id="ack" value="204 No Content&lt;br&gt;&lt;b&gt;Sync Boundary: F1 has expired&lt;/b&gt;&lt;br&gt;Does not wait for old FeedItem to be deleted" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#215E21;" vertex="1" parent="1"><mxGeometry x="180" y="325" width="245" height="75" as="geometry"/></mxCell>
        <mxCell id="relay" value="Follow Outbox&lt;br&gt;Relay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="755" y="180" width="130" height="75" as="geometry"/></mxCell>
        <mxCell id="events" value="FollowEvents Topic&lt;br&gt;FollowEnded(F1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="930" y="175" width="155" height="85" as="geometry"/></mxCell>
        <mxCell id="index-worker" value="Follow Index Worker&lt;br&gt;Deletes only items matching F1&lt;br&gt;Avoid accidentally deleting F2 created later" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="160" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="following" value="Following Index&lt;br&gt;Delete Bob: Alice → F1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#E2F0D9;strokeColor=#70AD47;" vertex="1" parent="1"><mxGeometry x="1370" y="110" width="165" height="80" as="geometry"/></mxCell>
        <mxCell id="followers" value="Followers Index&lt;br&gt;Delete Alice: Bob → F1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#E2F0D9;strokeColor=#70AD47;" vertex="1" parent="1"><mxGeometry x="1370" y="230" width="165" height="80" as="geometry"/></mxCell>
        <mxCell id="cache-worker" value="Cache Invalidation Worker&lt;br&gt;follow_version(Bob)++&lt;br&gt;Invalidation following:Bob&lt;br&gt;Invalidation feed-head:Bob" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1130" y="340" width="190" height="115" as="geometry"/></mxCell>
        <mxCell id="cleanup" value="Cleanup Worker&lt;br&gt;Deletes the old FeedItem in Bob&#x27;s home page with &lt;br&gt;author=Alice and follow_id=F1&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="895" y="340" width="185" height="115" as="geometry"/></mxCell>
        <mxCell id="feeditem" value="FeedItem Store&lt;br&gt;Physical cleanup may be delayed" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#E2F0D9;strokeColor=#70AD47;" vertex="1" parent="1"><mxGeometry x="1370" y="370" width="165" height="80" as="geometry"/></mxCell>
        <mxCell id="read-safety" value="Read path security gate&lt;br&gt;FeedItem.follow_id = F1&lt;br&gt;But Follow Store shows that F1 has ended&lt;br&gt;⇒ Filter immediately and do not return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="165" y="510" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="feed-query" value="Feed Query Service&lt;br&gt;Found cached or derived items still with F1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="525" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="no-resurrection" value="Refocusing later will get you F2. The old FeedItem still has F1, so it will not be revived; READ Post must also satisfy rank_time ≥ F2.followed_at." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="635" width="680" height="70" as="geometry"/></mxCell>
        <mxCell id="e1" value="DELETE /follows/Alice" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="bob" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="gateway" target="follow-service"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="local affairs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A7D44;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="follow-service" target="follow-store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="commit successful" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A7D44;endArrow=block;endFill=1;" edge="1" parent="1" source="follow-store" target="ack"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Scan Outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="follow-store" target="relay"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="relay" target="events"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;endArrow=block;endFill=1;" edge="1" parent="1" source="events" target="index-worker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="compare-and-delete F1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#70AD47;endArrow=block;endFill=1;" edge="1" parent="1" source="index-worker" target="following"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="compare-and-delete F1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#70AD47;endArrow=block;endFill=1;" edge="1" parent="1" source="index-worker" target="followers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="FollowingChanged" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;endArrow=block;endFill=1;" edge="1" parent="1" source="index-worker" target="cache-worker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="FollowEnded" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;endArrow=block;endFill=1;" edge="1" parent="1" source="events" target="cleanup"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="Asynchronous physical deletion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#70AD47;endArrow=block;endFill=1;" edge="1" parent="1" source="cleanup" target="feeditem"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="Candidate contains F1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=block;endFill=1;" edge="1" parent="1" source="feed-query" target="read-safety"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="Check the facts when necessary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A7D44;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="read-safety" target="follow-store"><mxGeometry relative="1" as="geometry"/></mxCell>
