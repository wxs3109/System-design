{
  "name": "system-design-simulator",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev": "pnpm --filter @system-design/web dev",
    "build": "pnpm -r --if-present run build",
    "lint": "node .tools/lint-content.mjs && pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "pnpm --filter @system-design/web test:e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e"
  }
}
