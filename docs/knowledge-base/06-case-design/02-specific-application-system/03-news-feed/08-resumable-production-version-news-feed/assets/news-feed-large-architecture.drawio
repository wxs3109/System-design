  <diagram id="recovery" name="04-Fault recovery and reconciliation">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ftitle" value="Fault recovery: discovery → location → hemostasis → replay → reconciliation" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="420" y="20" width="960" height="40" as="geometry"/></mxCell>

        <mxCell id="detectBox" value="1. Discovery and positioning" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#F8FAFC;strokeColor=#64748B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="1740" height="205" as="geometry"/></mxCell>
