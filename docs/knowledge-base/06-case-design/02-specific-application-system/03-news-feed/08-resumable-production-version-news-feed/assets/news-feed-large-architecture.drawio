        <mxCell id="outboxM" value="Outbox&#xa;oldest PENDING age" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="170" width="155" height="70" as="geometry"/></mxCell>
        <mxCell id="queueM" value="Queue&#xa;lag / oldest message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="495" y="170" width="155" height="70" as="geometry"/></mxCell>
        <mxCell id="workerM" value="Workers&#xa;throughput / retry / DLQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="170" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="shardM" value="Per-shard&#xa;QPS / P99 / errors / hot key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="165" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="ids" value="Stable IDs&#xa;trace / event / post / job / batch / shard&#xa;mode_version / follow_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150" y="155" width="235" height="100" as="geometry"/></mxCell>
        <mxCell id="impact" value="Impact Scope&#xa;post-123: WRITE v7&#xa;100 batches: 93 OK / 7 failed&#xa;all → feed-shard-8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1440" y="150" width="270" height="110" as="geometry"/></mxCell>

        <mxCell id="containBox" value="2. Hemostasis and replay" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#FAF5FF;strokeColor=#8B5CF6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="345" width="1740" height="220" as="geometry"/></mxCell>
        <mxCell id="throttle" value="Throttle/Pause
