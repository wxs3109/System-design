  <diagram id="readpath" name="03-Home page reading path">
    <mxGraphModel dx="1800" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="rtitle" value="GET /feed: two-way candidate, version verification and fact filtering" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="430" y="20" width="940" height="40" as="geometry"/></mxCell>
        <mxCell id="rlegend" value="The cache goes first, but when the cached version lags behind, it must go back to the source. WRITE Post comes from FeedItem; READ Post comes from Author Timeline; finally filtered by Post and Follow facts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="1140" height="42" as="geometry"/></mxCell>

        <mxCell id="requestBox" value="1. Request and Orchestration" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#EFF6FF;strokeColor=#3B82F6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="145" width="1740" height="190" as="geometry"/></mxCell>
        <mxCell id="rclient" value="Bob&#xa;GET /feed?cursor=..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="210" width="155" height="65" as="geometry"/></mxCell>
        <mxCell id="rgateway" value="Gateway / Auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="275" y="210" width="145" height="65" as="geometry"/></mxCell>
        <mxCell id="rfeed" value="Feed Query Service&#xa;orchestrator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="475" y="200" width="170" height="85" as="geometry"/></mxCell>
        <mxCell id="rsnapshot" value="Cursor Decoder&#xa;snapshot_time&#xa;last_rank_time / post_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="195" width="175" height="95" as="geometry"/></mxCell>
        <mxCell id="rmerge" value="Candidate Merge&#xa;k-way merge + dedupe&#xa;(rank_time, post_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="195" width="190" height="95" as="geometry"/></mxCell>
        <mxCell id="rfilter" value="Fact Filter&#xa;deleted? current follow_id?&#xa;rank_time ≥ followed_at?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1360" y="195" width="195" height="95" as="geometry"/></mxCell>
        <mxCell id="rresponse" value="20 items + signed cursor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1610" y="210" width="130" height="65" as="geometry"/></mxCell>

        <mxCell id="sourcesBox" value="2. Candidate sources and caching" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#FFF7ED;strokeColor=#F59E0B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="370" width="1740" height="290" as="geometry"/></mxCell>
        <mxCell id="rfollowCache" value="Following Cache&#xa;Bob → Alice / F2&#xa;follow_version" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="430" width="170" height="95" as="geometry"/></mxCell>
        <mxCell id="rmodeCache" value="Mode Cache&#xa;Alice READ intervals&#xa;mode_version" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="430" width="170" height="95" as="geometry"/></mxCell>
        <mxCell id="rfeedCache" value="Feed Head Cache&#xa;WRITE candidates&#xa;feed_version" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="430" width="170" height="95" as="geometry"/></mxCell>
        <mxCell id="rtimelineCache" value="Timeline Cache&#xa;READ candidates&#xa;timeline_version" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="430" width="175" height="95" as="geometry"/></mxCell>
        <mxCell id="rversion" value="Version Cache
feed / timeline / follow / post
Version mismatch → Back to source" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="945" y="415" width="190" height="115" as="geometry"/></mxCell>
        <mxCell id="rpostCache" value="Post Cache
Text / deleted / post_version
DELETED tombstone" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1190" y="420" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="rscan" value="Over-fetch Loop
Take 50 items each way first
If filtering is insufficient, continue
When the scanning limit is reached, the page will be shortened." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1440" y="420" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="rsourceNote" value="Feed Head does not cache pinned pages; only the most recent ID and rank_time are cached. Mode data is cached separately by author_id, and mode switching does not invalidate all fans in fan-out." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7C5B00;" vertex="1" parent="1"><mxGeometry x="300" y="565" width="1160" height="55" as="geometry"/></mxCell>

