<mxfile host="app.diagrams.net" modified="2026-08-13T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false">
  <diagram id="follow-flow" name="Follow the link">
    <mxGraphModel dx="1550" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1550" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Follow link: Create a new follow cycle and do not add historical posts." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=22;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="750" height="35" as="geometry"/></mxCell>
        <mxCell id="sync-zone" value="Synchronization: establishing the Follow fact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#6C8EBF;dashed=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=14;fontStyle=1;fontColor=#1D4E89;" vertex="1" parent="1"><mxGeometry x="30" y="75" width="665" height="350" as="geometry"/></mxCell>
        <mxCell id="async-zone" value="Asynchronous: Create derived indexes in both query directions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF8FF;strokeColor=#9673A6;dashed=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=14;fontStyle=1;fontColor=#5B376B;" vertex="1" parent="1"><mxGeometry x="725" y="75" width="790" height="535" as="geometry"/></mxCell>
        <mxCell id="bob" value="Bob&lt;br&gt;Follower" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="175" width="95" height="95" as="geometry"/></mxCell>
        <mxCell id="gateway" value="API Gateway&lt;br&gt;Authentication / Current Limitation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="205" y="185" width="130" height="75" as="geometry"/></mxCell>
        <mxCell id="follow-service" value="Follow Service&lt;br&gt;Confirm that Alice exists&lt;br&gt;Check that there is currently no valid relationship" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="170" width="170" height="105" as="geometry"/></mxCell>
        <mxCell id="follow-store" value="Follow Store&lt;br&gt;&lt;b&gt;Same Transaction&lt;/b&gt;&lt;br&gt;New follow_id = F2&lt;br&gt;followed_at = now&lt;br&gt;unfollowed_at = null&lt;br&gt;+ Follow Outbox" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#3A7D44;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="145" width="80" height="155" as="geometry"/></mxCell>
        <mxCell id="ack" value="201 Created&lt;br&gt;Return follow_id = F2&lt;br&gt;&lt;b&gt;Synchronization boundary&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#215E21;" vertex="1" parent="1"><mxGeometry x="230" y="325" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="semantic" value="Temporal semantics&lt;br&gt;Only allow rank_time ≥ F2.followed_at&lt;br&gt;Following operations will not backfill Alice’s old Posts" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="475" y="325" width="190" height="78" as="geometry"/></mxCell>
        <mxCell id="relay" value="Follow Outbox&lt;br&gt;Relay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="180" width="130" height="75" as="geometry"/></mxCell>
        <mxCell id="events" value="FollowEvents Topic&lt;br&gt;FollowStarted(F2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="175" width="155" height="85" as="geometry"/></mxCell>
        <mxCell id="worker" value="Follow Index Worker&lt;br&gt;Event by follow_id idempotent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150" y="175" width="175" height="85" as="geometry"/></mxCell>
        <mxCell id="following" value="Following Index&lt;br&gt;PK: follower_id = Bob&lt;br&gt;Alice → F2, followed_at&lt;br&gt;&lt;b&gt;Answer: Who am I following? &lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#E2F0D9;strokeColor=#70AD47;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1370" y="115" width="125" height="125" as="geometry"/></mxCell>
        <mxCell id="followers" value="Followers Index&lt;br&gt;PK: followee_id = Alice&lt;br&gt;Bob → F2, followed_at&lt;br&gt;&lt;b&gt;Answer: Who follows me? &lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#E2F0D9;strokeColor=#70AD47;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1370" y="295" width="125" height="125" as="geometry"/></mxCell>
        <mxCell id="version" value="Version Cache&lt;br&gt;follow_version(Bob)++" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1145" y="330" width="185" height="80" as="geometry"/></mxCell>
        <mxCell id="cache-worker" value="Cache Invalidation Worker&lt;br&gt;Invalidation following:Bob&lt;br&gt;Invalidation feed-head:Bob" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="920" y="330" width="175" height="90" as="geometry"/></mxCell>
        <mxCell id="truth-note" value="Follow Store is the source of fact; Following and Followers are just indexes in two query directions. In case of conflict, they will be repaired according to the currently valid follow_id." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="840" y="490" width="565" height="70" as="geometry"/></mxCell>
        <mxCell id="e1" value="POST /follows/Alice" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="bob" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="gateway" target="follow-service"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="local affairs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A7D44;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="follow-service" target="follow-store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="commit successful" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A7D44;endArrow=block;endFill=1;" edge="1" parent="1" source="follow-store" target="ack"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Scan Outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="follow-store" target="relay"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Publish at least once" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="relay" target="events"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="events" target="worker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="upsert Alice → F2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#70AD47;endArrow=block;endFill=1;" edge="1" parent="1" source="worker" target="following"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="upsert Bob → F2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#70AD47;endArrow=block;endFill=1;" edge="1" parent="1" source="worker" target="followers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="Updated version" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;endArrow=block;endFill=1;" edge="1" parent="1" source="worker" target="version"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="FollowingChanged" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;endArrow=block;endFill=1;" edge="1" parent="1" source="worker" target="cache-worker"><mxGeometry relative="1" as="geometry"/></mxCell>
